# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://nigohfamily.qobus.tj/auth/google/callback

# Admin panel account (no default password in code; set to create/reset it)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=

# OAuth client IDs whose Google ID tokens the Android app may send
# (web client used as serverClientId, plus the Android client), comma-separated
GOOGLE_MOBILE_CLIENT_IDS=

# Optional TURN server for reliable voice calls on mobile networks (WebRTC)
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_USERNAME=
TURN_PASSWORD=

# Sign in with Apple (leave empty to hide the Apple button). See docs/APPLE_SIGNIN_SETUP.md
APPLE_CLIENT_ID=            # Services ID, e.g. tj.nigoh.nigohfamily.web
APPLE_TEAM_ID=              # 10-character Team ID
APPLE_KEY_ID=               # 10-character Key ID of the "Sign in with Apple" key
APPLE_PRIVATE_KEY_PATH=     # path to the downloaded AuthKey_XXXXXXXXXX.p8 (or put the key text in APPLE_PRIVATE_KEY)

# Sign in with GitHub (leave empty to hide the GitHub button). See docs/GITHUB_SIGNIN_SETUP.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
